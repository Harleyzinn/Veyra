{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2023", "DOM"],
    "noEmit": true,
    "typeRoots": ["../desktop/node_modules/@types"],
    "baseUrl": ".",
    "paths": {
      "react": ["../desktop/node_modules/@types/react"],
      "react/*": ["../desktop/node_modules/@types/react/*"],
      "react-dom/*": ["../desktop/node_modules/@types/react-dom/*"],
      "lucide-react": ["../desktop/node_modules/lucide-react"]
    }
  },
  "include": ["*.ts", "*.tsx", "tests/*.ts"]
}
